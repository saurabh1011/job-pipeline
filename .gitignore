# Personal profile data — never commit (deploy to Fly.io volume separately)
profile/

# Database (lives on Fly.io persistent volume in prod, local only in dev)
jobs.db
jobs.db-shm
jobs.db-wal

# Local Docker Compose persistent volume (mirrors Fly's /data mount)
data/

# Auth database (generated at runtime)
auth.db
auth.db-shm
auth.db-wal

# Pipeline state
pipeline_checkpoint.json

# Generated output (cover letters, PDFs)
output/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
venv/

# Secrets (never commit)
.env*
*.key
config/preferences.yaml

# Live per-user app data, editable from the UI — not code. Seeded from
# config/companies.yaml.example on first run (see web/server.py).
config/companies.yaml

# macOS
.DS_Store

# Claude Code — per-developer/per-machine local permissions, not shared state.
# Accumulates automatically as commands get approved; must never be committed
# (a backlog_agent.py run once swept a whole session's worth of these into a
# PR via `git add -u`, since this was tracked).
.claude/settings.local.json

# Backlog agent runtime artifacts
agent/logs/
.agent-worktrees/
