<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the launchd LaunchAgent that keeps the local job-pipeline
  web server running (127.0.0.1:8000). Rendered and installed to
  ~/Library/LaunchAgents/ by setup_local_pipeline.sh — do not edit the
  rendered copy by hand, edit this template and re-run the installer.

  No secrets live in this file; run_server.sh sources .env.local at
  the repo root for those.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jobpipeline.local-server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO_ROOT__/scripts/local/run_server.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__REPO_ROOT__/logs/local-server.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_ROOT__/logs/local-server-error.log</string>
</dict>
</plist>
